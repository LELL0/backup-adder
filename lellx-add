#!/usr/bin/env python3
"""Backup Adder command line (Linux and Windows).

  lellx-add --list                                         # drives found
  lellx-add SRC --drive LELLX --into BACKUPS/Phones --name "Samsung A30" --date 2027-03-01           # dry run
  lellx-add SRC --drive LELLX --into BACKUPS/Phones --name "Samsung A30" --date 2027-03-01 --apply   # copy
  lellx-add SRC --folder /path/to/target --name X --apply   # any folder as target (network share…)
  lellx-add SRC --drive LELLX --name X --match name        # skip files whose name is already on the drive
  lellx-add --drive LELLX --find IMG_0597
  lellx-add --drive LELLX --rescan | --status | --eject

--drive matches the drive label, id, mount point or device (case-insensitive substring).
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import backup_core as core  # noqa: E402

for _s in (sys.stdout, sys.stderr):
    try:
        _s.reconfigure(errors="replace")      # Windows consoles may not encode "…" / "—"
    except (AttributeError, ValueError):
        pass

ap = argparse.ArgumentParser(description="Add a backup to a drive without duplicate files.",
                             formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
ap.add_argument("source", nargs="?")
ap.add_argument("--list", action="store_true", help="list drives")
ap.add_argument("--drive", help="target drive (label / id / mount point / device)")
ap.add_argument("--folder", help="use this folder as the target instead of a drive")
ap.add_argument("--into", default="", help="folder on the drive that receives the backup, e.g. BACKUPS/Phones")
ap.add_argument("--name")
ap.add_argument("--date", default="", help="YYYY-MM-DD (empty = no date)")
ap.add_argument("--apply", action="store_true", help="really copy (otherwise only show the plan)")
ap.add_argument("--match", choices=["content", "name+size", "name"], default="content",
                help="how to detect files already on the drive: content (byte-identical, default), "
                     "name+size, or name only (content not compared)")
ap.add_argument("--rescan", action="store_true", help="update the drive index from the drive first")
ap.add_argument("--delete-source", action="store_true", help="delete originals after verified copy")
ap.add_argument("--report", help="write the plan as TSV")
ap.add_argument("--quiet", action="store_true", help="only print the summary, not every file")
ap.add_argument("--find")
ap.add_argument("--status", action="store_true")
ap.add_argument("--eject", action="store_true")
a = ap.parse_args()

if a.list:
    for d in core.list_drives():
        print(f"{d.kind:6s} {d.id:28s} {d.title}")
    sys.exit(0)


def pick():
    if a.folder:
        return core.folder_drive(a.folder)
    drives = core.list_drives()
    if not a.drive:
        if len(drives) == 1:
            return drives[0]
        ap.error("several drives found, choose one with --drive (see --list)" if drives else "no drive found")
    q = a.drive.lower()
    hits = [d for d in drives if q in " ".join([d.label, d.id, d.root, d.device]).lower()]
    if len(hits) != 1:
        ap.error(f"--drive '{a.drive}' matches {len(hits)} drives (see --list)")
    return hits[0]


drive = pick()
if a.eject:
    core.eject(drive)
    print("Drive ejected, safe to unplug.")
    sys.exit(0)
core.prepare(drive, write=False)
idx = core.Index(drive)


def publish():
    try:
        core.prepare(drive, write=True)
        idx.save()
    except core.DriveError:
        idx.save(to_drive=False)
    finally:
        core.finish(drive)


if a.status:
    h = core.drive_health(drive)
    n, size, hashed = idx.stats()
    print(f"{drive.title}\nfree: {core.human(h['free'])} of {core.human(h['total'])}  health: {h['smart']}\n"
          f"index: {n:,} files ({core.human(size)}), {hashed:,} hashed, updated {idx.info('built')}")
    for w in h["warnings"]:
        print("WARNING:", w)
    sys.exit(0)
if a.find:
    for p, s in idx.search(a.find):
        print(f"{core.human(s):>9}  {p}")
    sys.exit(0)
if a.rescan and not a.source:
    r = core.scan(idx, lambda s: print("\r" + s, end="", flush=True))
    publish()
    print(f"\nIndex updated: {r}")
    sys.exit(0)
if not a.source or not a.name:
    ap.error("SOURCE and --name are required")

dest = core.make_dest(a.into, a.name, a.date)
last = [-1]


def prog(d, t):
    p = int(d * 100 / t) if t else 100
    if p != last[0]:
        last[0] = p
        print(f"\r{p:3d}%", end="", flush=True)


first = idx.empty
plan = core.analyze(a.source, dest, idx, (lambda s: print("\r" + s[:100].ljust(100), end="", flush=True)) if first or a.rescan else None,
                    prog, None, a.rescan, a.match)
if first or a.rescan:
    publish()
print()
t = plan.totals()
if not a.quiet:
    for it in plan.items:
        print(f"{it.action:5s} {core.human(it.size):>9}  {it.rel}  — {it.reason}" + (f"  => {it.existing}" if it.existing else ""))
print(f"\nDestination: {os.path.join(drive.root, *dest.split('/'))}\nCOPY {t['COPY'][0]} ({core.human(t['COPY'][1])})  "
      f"SKIP {t['SKIP'][0]} ({core.human(t['SKIP'][1])})  ERROR {t['ERROR'][0]}")
if a.report:
    core.export_report(plan, a.report)
if not a.apply:
    print("\nDry run only. Add --apply to copy.")
    sys.exit(0)
core.prepare(drive, write=True)
try:
    res = core.execute(plan, idx, a.delete_source, None, prog)
finally:
    core.finish(drive)
print(f"\nDone. failures={len(res['failures'])} originals_deleted={res['deleted']} originals_kept={res.get('kept', 0)}")
